@model List<WishlistItem>
@{
    ViewData["Title"] = "My Wishlist";
}

<div class="container py-4">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3">
            <div class="card shadow-sm mb-4">
                <div class="list-group list-group-flush">
                    <a asp-action="Profile" class="list-group-item list-group-item-action">
                        <i class="bi bi-person"></i> Profile
                    </a>
                    <a asp-action="Orders" class="list-group-item list-group-item-action">
                        <i class="bi bi-bag"></i> My Orders
                    </a>
                    <a asp-action="Wishlist" class="list-group-item list-group-item-action active">
                        <i class="bi bi-heart"></i> Wishlist
                    </a>
                    <a asp-action="ChangePassword" class="list-group-item list-group-item-action">
                        <i class="bi bi-key"></i> Change Password
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-heart"></i> My Wishlist</h5>
                </div>
                <div class="card-body">
                    @if (Model.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-heart display-1 text-muted"></i>
                            <h4 class="mt-3">Your wishlist is empty</h4>
                            <p class="text-muted">Save items you love to your wishlist.</p>
                            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
                                <i class="bi bi-shop"></i> Browse Products
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            @foreach (var item in Model)
                            {
                                <div class="col-md-4 col-sm-6" id="wishlistItem-@item.Id">
                                    <div class="card h-100 shadow-sm">
                                        <div class="position-relative">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">
                                                <img src="@(item.Product?.MainImageUrl ?? "https://via.placeholder.com/300x300?text=No+Image")"
                                                     class="card-img-top" alt="@item.Product?.Name" style="height: 200px; object-fit: cover;" />
                                            </a>
                                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2"
                                                    onclick="removeFromWishlist(@item.ProductId)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                        <div class="card-body">
                                            <p class="text-muted mb-1 small">@item.Product?.Brand?.Name</p>
                                            <h6 class="card-title">@item.Product?.Name</h6>
                                            <h5 class="text-primary">RS @item.Product?.SalePrice.ToString("N0")</h5>
                                            <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-primary w-100" @(item.Product?.StockQuantity <= 0 ? "disabled" : "")>
                                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                                </button>
                                            </form>                                            
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function removeFromWishlist(productId) {
            if (confirm('Remove from wishlist?')) {
                $.post('@Url.Action("RemoveFromWishlist", "Account")', { productId: productId }, function(data) {
                    if (data.success) {
                        location.reload();
                    }
                });
            }
        }
    </script>
}